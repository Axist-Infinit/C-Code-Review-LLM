# environments & caches
.venv/
hf_cache/
__pycache__/
*.pyc

# model weights & bases (move between machines via pack_model.sh)
models/
vuln-model*/
llm-base/
llm-surface-lora/
llm-surface-merged/
*.tar.zst
*.safetensors

# datasets (regenerate via fetch_bigvul_hf.py / bootstrap_data.sh)
data/*
!data/.gitkeep

# scan outputs
scan_out/

# ccr.sh menu state (saved settings, ollama log, generated Modelfile)
.ccr/

# code dropped in for review — never commit someone else's source
review_inbox/*
!review_inbox/.gitkeep
!review_inbox/README.md

# third-party test corpora (clone separately)
TestCodeToScan/
playground/dtls_*.c

# machine-generated
.env.locked
*Zone.Identifier
torch.lock
dist/
